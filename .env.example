# Copy to .env and fill in. This file is read by tools/*.py (deploy), docker compose and the app.

# --- Server (used by tools/deploy.py) ---
SERVER_IP=192.168.1.10
SERVER_SSH_LOGIN=user
SERVER_SSH_PASSWORD=
# Recordings directory on the server (mounted into the containers as /data)
SERVER_CAM_DATA_DIR=/store/camdata

# --- Web application ---
APP_PORT=8080
APP_URL=http://192.168.1.10:8080
# generate: php artisan key:generate --show   (or any "base64:" + 32 random bytes in base64)
APP_KEY=
TZ=Europe/Moscow
# The admin user is created on the first start
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# --- Recording ---
# Total size of recordings, GB. Oldest files are deleted above this limit.
STORAGE_LIMIT_GB=200
# Always keep this much free disk space, GB
MIN_FREE_GB=5
# A camera is reported unavailable after this many seconds without video
CAMERA_OFFLINE_AFTER=60

# --- Live view (WebRTC port, open TCP+UDP on the server firewall) ---
WEBRTC_PORT=8555
# External host name or IP for WebRTC from the internet (router forwards 8555 tcp+udp)
WEBRTC_PUBLIC=

# --- Telegram alerts (the bot must be a member of the group) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional proxy for Telegram: http://user:pass@host:3128 or socks5h://user:pass@host:1080
TELEGRAM_PROXY=
